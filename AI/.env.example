# ==============================================================================
# HarvestWindow Python AI & ML Microservice Environment Configuration
# Copy this file to AI/.env and customize with your local settings.
# ==============================================================================

# FastAPI Server Port
PORT=8000
ENVIRONMENT=development

# MLflow Experiment & Model Registry URI
# Uses local SQLite database by default
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=harvestwindow-harvest-models

# Optional MySQL connection for offline ingestion jobs
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/harvestwindow"
