# ==============================================================================
# HarvestWindow Platform Environment Overview
# ==============================================================================
# HarvestWindow is an enterprise agricultural intelligence system composed of
# three services. Each service contains its own focused .env file:
#
# 1. Backend API Gateway       --> backend/.env.example
# 2. Frontend React Client     --> frontend/.env.example
# 3. Python AI Microservice    --> AI/.env.example
#
# Below is a quick unified reference of all configuration options:
# ==============================================================================

# --- [BACKEND: backend/.env] ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="mysql://root:password@localhost:3306/harvestwindow"
TEST_DATABASE_URL="mysql://root:password@localhost:3306/harvestwindow_test"
JWT_ACCESS_SECRET="replace_with_a_long_random_secret_at_least_32_chars_min_example"
JWT_REFRESH_SECRET="replace_with_an_independent_long_random_secret_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=harvestwindow-auth
JWT_AUDIENCE=harvestwindow-app
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_NAME="HarvestWindow Administrator"
ADMIN_EMAIL="admin@harvestwindow.local"
ADMIN_PASSWORD="HarvestAdmin#2026!Secure"
HARVEST_AI_SERVICE_URL=http://127.0.0.1:8000
WEATHERAPI_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# Agricultural AI Assistant LLM Options ("local" requires 0 API keys)
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# --- [FRONTEND: frontend/.env] ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_MODE=live

# --- [PYTHON AI MICROSERVICE: AI/.env] ---
PORT=8000
ENVIRONMENT=development
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=harvestwindow-harvest-models
