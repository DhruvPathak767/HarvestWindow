generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  SELLER
  BUYER
  EXPERT
  ADMIN
}

model User {
  id              String           @id @default(cuid())
  name            String           @db.VarChar(120)
  email           String           @unique @db.VarChar(191)
  passwordHash    String           @db.VarChar(255)
  role            Role             @default(FARMER)
  emailVerifiedAt DateTime?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  farms           Farm[]

  @@index([role])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String    @db.VarChar(191)
  tokenHash String    @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(500)
  ipAddress String?   @db.VarChar(45)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

// Farm model for Phase 2 Farm Management
model Farm {
  id               String   @id @default(cuid())
  userId           String   @db.VarChar(191)
  name             String   @db.VarChar(120)
  state            String   @db.VarChar(100)
  district         String   @db.VarChar(100)
  soilType         String?  @db.VarChar(100)
  irrigationSource String?  @db.VarChar(100)
  village          String?  @db.VarChar(120)
  pincode          String?  @db.VarChar(20)
  latitude         Decimal? @db.Decimal(10, 6)
  longitude        Decimal? @db.Decimal(10, 6)
  area             Decimal  @db.Decimal(12, 2)
  areaUnit         String   @default("hectare") @db.VarChar(20) // "hectare" | "acre"
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops            Crop[]

  @@index([userId])
  @@map("farms")
}

// Crop model for Phase 3 Crop Management
model Crop {
  id                  String    @id @default(cuid())
  farmId              String    @db.VarChar(191)
  cropName            String    @db.VarChar(120)
  variety             String?   @db.VarChar(100)
  sowingDate          DateTime
  expectedHarvestDate DateTime?
  growthStage         String?   @db.VarChar(50)
  irrigationMethod    String?   @db.VarChar(100)
  irrigationFrequency String?   @db.VarChar(100)
  fieldArea           Decimal?  @db.Decimal(12, 2)
  expectedYield       String?   @db.VarChar(100)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  farm                Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([cropName])
  @@index([growthStage])
  @@map("crops")
}
