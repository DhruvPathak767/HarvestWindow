datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User model from Phase 1 Authentication
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  fullName     String
  role         String?   @default("Farm manager")
  organisation String?   @default("Independent")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  farms        Farm[]

  @@map("users")
}

// Farm model for Phase 2 Farm Management
model Farm {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  district  String   @db.VarChar(100)
  latitude  Decimal? @db.Decimal(10, 6)
  longitude Decimal? @db.Decimal(10, 6)
  area      Decimal  @db.Decimal(12, 2)
  areaUnit  String   @db.VarChar(20) // "hectare" | "acre"
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("farms")
}
