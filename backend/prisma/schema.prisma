generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  SELLER
  BUYER
  EXPERT
  ADMIN
}

enum AreaUnit {
  HECTARE
  ACRE
}

model User {
  id              String           @id @default(cuid())
  name            String           @db.VarChar(120)
  email           String           @unique @db.VarChar(191)
  passwordHash    String           @db.VarChar(255)
  role            Role             @default(FARMER)
  emailVerifiedAt DateTime?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshSessions RefreshSession[]
  farms           Farm[]
  settings        UserSettings?
  recommendations Recommendation[]
  activities      Activity[]
  notifications   Notification[]
  harvestPredictions HarvestPrediction[]
  weatherAssessments WeatherAssessment[]
  yieldPredictions   YieldPrediction[]
  actualProductions  ActualProduction[]
  cropHealthAnalyses CropHealthAnalysis[]
  harvestOutcomes    HarvestOutcome[]

  @@index([role])
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String    @db.VarChar(191)
  tokenHash String    @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(500)
  ipAddress String?   @db.VarChar(45)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_sessions")
}

// Farm model matching updated specifications
model Farm {
  id               String    @id @default(cuid())
  userId           String    @db.VarChar(191)
  name             String    @db.VarChar(120)
  state            String    @db.VarChar(100)
  district         String    @db.VarChar(100)
  villageOrTaluka  String?   @db.VarChar(120)
  postalCode       String?   @db.VarChar(10)
  soilType         String?   @db.VarChar(50)
  irrigationSource String?   @db.VarChar(50)
  area             Decimal   @db.Decimal(12, 2)
  areaUnit         AreaUnit  @default(HECTARE)
  latitude         Decimal?  @db.Decimal(10, 6)
  longitude        Decimal?  @db.Decimal(10, 6)
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops                  Crop[]
  defaultForUserSettings UserSettings[]   @relation("DefaultFarmSettings")
  recommendations        Recommendation[]
  activities             Activity[]
  notifications          Notification[]
  harvestPredictions     HarvestPrediction[]
  weatherAssessments     WeatherAssessment[]
  yieldPredictions       YieldPrediction[]
  actualProductions      ActualProduction[]
  cropHealthAnalyses     CropHealthAnalysis[]
  harvestOutcomes        HarvestOutcome[]

  @@index([userId])
  @@map("farms")
}

// User settings model for Phase 8 Settings & Preferences
model UserSettings {
  id                  String    @id @default(cuid())
  userId              String    @unique @db.VarChar(191)
  areaUnit            String    @default("hectare") @db.VarChar(20)
  temperatureUnit     String    @default("celsius") @db.VarChar(20)
  language            String    @default("en") @db.VarChar(10)
  defaultFarmId       String?   @db.VarChar(191)
  harvestWindowAlerts Boolean   @default(true)
  weatherCautions     Boolean   @default(true)
  weeklySummary       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultFarm         Farm?     @relation("DefaultFarmSettings", fields: [defaultFarmId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([defaultFarmId])
  @@map("user_settings")
}

// Crop model for Phase 3 Crop Management
model Crop {
  id                  String    @id @default(cuid())
  farmId              String    @db.VarChar(191)
  cropName            String    @db.VarChar(120)
  variety             String?   @db.VarChar(100)
  sowingDate          DateTime
  expectedHarvestDate DateTime?
  growthStage         String?   @db.VarChar(50)
  irrigationMethod    String?   @db.VarChar(100)
  irrigationFrequency String?   @db.VarChar(100)
  fieldArea           Decimal?  @db.Decimal(12, 2)
  expectedYield       String?   @db.VarChar(100)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  farm                Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  recommendations     Recommendation[]
  activities          Activity[]
  notifications       Notification[]
  harvestPredictions  HarvestPrediction[]
  weatherAssessments  WeatherAssessment[]
  yieldPredictions    YieldPrediction[]
  actualProductions   ActualProduction[]
  cropHealthAnalyses  CropHealthAnalysis[]
  harvestOutcomes     HarvestOutcome[]

  @@index([farmId])
  @@index([cropName])
  @@index([growthStage])
  @@map("crops")
}

// Recommendation model for Phase 6 Recommendation Engine
model Recommendation {
  id              String    @id @default(cuid())
  userId          String    @db.VarChar(191)
  farmId          String?   @db.VarChar(191)
  cropId          String?   @db.VarChar(191)
  ruleKey         String    @db.VarChar(120)
  title           String    @db.VarChar(255)
  reason          String    @db.Text
  suggestedAction String    @db.Text
  category        String    @db.VarChar(50) // "weather" | "timing" | "logistics" | "monitoring"
  priority        String    @db.VarChar(20) // "low" | "medium" | "high"
  status          String    @default("open") @db.VarChar(20) // "open" | "completed" | "dismissed"
  relevantDate    DateTime?
  sourceContext   String?   @db.Text
  completedAt     DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm            Farm?     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop            Crop?     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, ruleKey])
  @@index([farmId])
  @@index([cropId])
  @@map("recommendations")
}

// Activity model for Phase 9 Activity Feed
model Activity {
  id          String   @id @default(cuid())
  userId      String   @db.VarChar(191)
  type        String   @db.VarChar(60)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  entityType  String?  @db.VarChar(50)
  entityId    String?  @db.VarChar(191)
  farmId      String?  @db.VarChar(191)
  cropId      String?  @db.VarChar(191)
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm        Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([farmId])
  @@index([cropId])
  @@map("activities")
}

// Notification model for Phase 9 In-App Alerts & Notifications
model Notification {
  id        String    @id @default(cuid())
  userId    String    @db.VarChar(191)
  type      String    @db.VarChar(50) // "weather" | "forecast" | "activity" | "recommendation"
  title     String    @db.VarChar(255)
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  link      String?   @db.VarChar(255)
  farmId    String?   @db.VarChar(191)
  cropId    String?   @db.VarChar(191)
  metadata  String?   @db.Text
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm      Farm?     @relation(fields: [farmId], references: [id], onDelete: SetNull)
  crop      Crop?     @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([farmId])
  @@index([cropId])
  @@map("notifications")
}

// ==========================================
// Phase AI-1: Agricultural Knowledge Base Models
// ==========================================

// 5.8 Agricultural Data Source & Provenance
model AgriculturalDataSource {
  id                  String    @id @default(cuid())
  sourceName          String    @unique @db.VarChar(120)
  sourceUrl           String?   @db.VarChar(500)
  datasetTitle        String?   @db.VarChar(255)
  publisher           String?   @db.VarChar(150)
  license             String?   @db.VarChar(100)
  geographicCoverage  String?   @db.VarChar(200)
  dataOrigin          String    @default("official_reference") @db.VarChar(50) // "official_reference" | "observed" | "derived" | "synthetic" | "unknown"
  publicationDate     DateTime?
  verificationStatus  String    @default("verified") @db.VarChar(50) // "verified" | "reference_only" | "unverified" | "synthetic"
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  calendars           CropCalendar[]
  growthProfiles      CropGrowthProfile[]
  suitabilityProfiles CropSuitabilityProfile[]
  varieties           CropVariety[]
  importBatches       AgriculturalImportBatch[]

  @@map("agricultural_data_sources")
}

// 5.9 Agricultural Import Batch Tracking
model AgriculturalImportBatch {
  id               String                  @id @default(cuid())
  sourceId         String?                 @db.VarChar(191)
  datasetName      String                  @db.VarChar(150)
  startedAt        DateTime                @default(now())
  completedAt      DateTime?
  rowsRead         Int                     @default(0)
  rowsAccepted     Int                     @default(0)
  rowsRejected     Int                     @default(0)
  rowsInserted     Int                     @default(0)
  rowsUpdated      Int                     @default(0)
  rowsSkipped      Int                     @default(0)
  status           String                  @default("in_progress") @db.VarChar(30) // "in_progress" | "completed" | "failed" | "dry_run"
  errorSummary     String?                 @db.Text
  rejectedDetails  String?                 @db.LongText // JSON array of sample rejected records with reasons
  createdAt        DateTime                @default(now())

  source           AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([datasetName])
  @@index([status])
  @@map("agricultural_import_batches")
}

// 5.1 Canonical Crop Master
model CropMaster {
  id             String                   @id @default(cuid())
  name           String                   @unique @db.VarChar(120)
  scientificName String?                  @db.VarChar(150)
  category       String                   @db.VarChar(60) // "Cereals" | "Pulses" | "Oilseeds" | "Commercial" | "Vegetables" | "Fruits" | "Spices" | "Fiber"
  description    String?                  @db.Text
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  varieties      CropVariety[]
  calendars      CropCalendar[]
  growthProfiles CropGrowthProfile[]
  suitabilities  CropSuitabilityProfile[]

  @@index([category])
  @@index([isActive])
  @@map("crop_masters")
}

// 5.2 Crop Variety
model CropVariety {
  id                      String                  @id @default(cuid())
  cropId                  String                  @db.VarChar(191)
  name                    String                  @db.VarChar(120)
  officialCode            String?                 @db.VarChar(100)
  regionRecommendation    String?                 @db.Text
  typicalDurationMinDays  Int?
  typicalDurationMaxDays  Int?
  sourceId                String?                 @db.VarChar(191)
  verificationStatus      String                  @default("unverified") @db.VarChar(50)
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  crop                    CropMaster              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  source                  AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  calendars               CropCalendar[]
  growthProfiles          CropGrowthProfile[]

  @@unique([cropId, name])
  @@index([cropId])
  @@map("crop_varieties")
}

// 5.4 Agricultural Season
model CropSeason {
  id                 String         @id @default(cuid())
  name               String         @unique @db.VarChar(60) // "Kharif" | "Rabi" | "Zaid" | "Whole Year"
  description        String?        @db.Text
  monthsCovered      String?        @db.VarChar(100)
  geographicCoverage String?        @default("India") @db.VarChar(100)
  verificationStatus String         @default("verified") @db.VarChar(50)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  calendars          CropCalendar[]

  @@map("crop_seasons")
}

// 5.3 Agricultural Region (States & Districts)
model AgriculturalRegion {
  id          String                 @id @default(cuid())
  country     String                 @default("India") @db.VarChar(100)
  state       String                 @db.VarChar(100)
  district    String?                @db.VarChar(100)
  zone        String?                @db.VarChar(120) // e.g. "Zone 4: Middle Gangetic Plain"
  latitude    Decimal?               @db.Decimal(10, 6)
  longitude   Decimal?               @db.Decimal(10, 6)
  provenance  String?                @db.VarChar(150)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  calendars   CropCalendar[]
  yieldRecords CropYieldObservation[]

  @@unique([state, district])
  @@index([state])
  @@index([district])
  @@map("agricultural_regions")
}

// 5.5 Regional Sowing & Harvest Crop Calendar
model CropCalendar {
  id                  String                  @id @default(cuid())
  cropId              String                  @db.VarChar(191)
  varietyId           String?                 @db.VarChar(191)
  regionId            String                  @db.VarChar(191)
  seasonId            String                  @db.VarChar(191)
  sowingStartMonth    Int                     // 1 - 12
  sowingStartDay      Int?                    // 1 - 31
  sowingEndMonth      Int                     // 1 - 12
  sowingEndDay        Int?                    // 1 - 31
  harvestStartMonth   Int?                    // 1 - 12
  harvestStartDay     Int?                    // 1 - 31
  harvestEndMonth     Int?                    // 1 - 12
  harvestEndDay       Int?                    // 1 - 31
  crossesYearBoundary Boolean                 @default(false)
  sourceId            String?                 @db.VarChar(191)
  verificationStatus  String                  @default("reference_only") @db.VarChar(50)
  validityYear        String?                 @db.VarChar(50)
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  crop                CropMaster              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety             CropVariety?            @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  region              AgriculturalRegion      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  season              CropSeason              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  source              AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([cropId, regionId, seasonId])
  @@index([regionId])
  @@index([seasonId])
  @@map("crop_calendars")
}

// 5.6 Crop Growth & GDD Profile
model CropGrowthProfile {
  id                        String                  @id @default(cuid())
  cropId                    String                  @db.VarChar(191)
  varietyId                 String?                 @db.VarChar(191)
  minDurationDays           Int
  typicalDurationDays       Int
  maxDurationDays           Int
  baseTemperature           Decimal?                @db.Decimal(5, 2) // Base temp Tbase in Celsius
  upperTemperatureThreshold Decimal?                @db.Decimal(5, 2) // Upper threshold in Celsius
  gddRequirementMin         Decimal?                @db.Decimal(8, 2) // Growing Degree Days
  gddRequirementTypical     Decimal?                @db.Decimal(8, 2)
  gddRequirementMax         Decimal?                @db.Decimal(8, 2)
  gddMethod                 String?                 @db.VarChar(120) // e.g. "Standard Daily Mean: max(0, (Tmax+Tmin)/2 - Tbase)"
  stageDurationsJson        String?                 @db.Text // JSON breakdown e.g. {"germination": 7, "vegetative": 40, "flowering": 25, "ripening": 30}
  conditions                String?                 @db.Text
  sourceId                  String?                 @db.VarChar(191)
  verificationStatus        String                  @default("verified") @db.VarChar(50)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  crop                      CropMaster              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  variety                   CropVariety?            @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  source                    AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([cropId])
  @@index([varietyId])
  @@map("crop_growth_profiles")
}

// 5.7 Crop Environmental & Soil Suitability Profile
model CropSuitabilityProfile {
  id                          String                  @id @default(cuid())
  cropId                      String                  @db.VarChar(191)
  soilTypes                   String?                 @db.Text // e.g. "Alluvial, Deep Black Soil, Loamy"
  soilPhMin                   Decimal?                @db.Decimal(4, 2)
  soilPhMax                   Decimal?                @db.Decimal(4, 2)
  tempMinC                    Decimal?                @db.Decimal(5, 2)
  tempMaxC                    Decimal?                @db.Decimal(5, 2)
  rainfallMinMm               Decimal?                @db.Decimal(8, 2)
  rainfallMaxMm               Decimal?                @db.Decimal(8, 2)
  waterRequirementDescription String?                 @db.Text
  drainageRequirement         String?                 @db.VarChar(100)
  soilConstraints             String?                 @db.Text
  geographicApplicability     String?                 @db.VarChar(150)
  sourceId                    String?                 @db.VarChar(191)
  verificationStatus          String                  @default("verified") @db.VarChar(50)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  crop                        CropMaster              @relation(fields: [cropId], references: [id], onDelete: Cascade)
  source                      AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([cropId])
  @@map("crop_suitability_profiles")
}

// Historical Yield Observations (From Kaggle & HF India Crop Yield Dataset)
model CropYieldObservation {
  id                    String              @id @default(cuid())
  cropNameRaw           String              @db.VarChar(120)
  stateRaw              String              @db.VarChar(100)
  districtRaw           String?             @db.VarChar(100)
  seasonRaw             String              @db.VarChar(60)
  year                  Int
  areaHectares          Decimal?            @db.Decimal(12, 2)
  productionTonnes      Decimal?            @db.Decimal(14, 2)
  yieldTonnesPerHectare Decimal?            @db.Decimal(10, 4)
  annualRainfallMm      Decimal?            @db.Decimal(8, 2)
  fertilizerUsageKg     Decimal?            @db.Decimal(18, 2)
  pesticideUsageKg      Decimal?            @db.Decimal(16, 2)
  sourceName            String              @db.VarChar(100)
  isSynthetic           Boolean             @default(false)
  dataOrigin            String              @default("observed") @db.VarChar(50)
  verificationStatus    String              @default("reference_only") @db.VarChar(50)
  regionId              String?             @db.VarChar(191)
  createdAt             DateTime            @default(now())

  region                AgriculturalRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([cropNameRaw])
  @@index([stateRaw])
  @@index([year])
  @@index([sourceName])
  @@map("crop_yield_observations")
}

// Crop Disease Dataset Metadata Inventory (From DigiGreen/Crop_Disease_Images)
model CropDiseaseMetadata {
  id            String   @id @default(cuid())
  crop          String   @db.VarChar(100)
  diagnosis     String   @db.VarChar(150)
  details       String?  @db.Text
  country       String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  imageFileRef  String   @db.VarChar(255)
  sourceDataset String   @default("DigiGreen/Crop_Disease_Images") @db.VarChar(120)
  createdAt     DateTime @default(now())

  @@index([crop])
  @@index([diagnosis])
  @@map("crop_disease_metadata")
}

// ==========================================
// Phase AI-2: Harvest Window Prediction Engine Models
// ==========================================
model HarvestPrediction {
  id                    String    @id @default(cuid())
  userId                String    @db.VarChar(191)
  farmId                String    @db.VarChar(191)
  cropId                String    @db.VarChar(191)
  predictionDate        DateTime  @default(now())
  estimatedHarvestStart DateTime?
  mostLikelyHarvestDate DateTime
  estimatedHarvestEnd   DateTime?
  daysUntilHarvest      Int       @default(0)
  isPastDue             Boolean   @default(false)
  predictionMethod      String    @db.VarChar(50) // "agronomic_baseline" | "agronomic_gdd_weather" | "supervised_ml"
  modelVersion          String    @db.VarChar(60)
  uncertaintyType       String?   @db.VarChar(50)
  uncertaintySpanDays   Int?
  baseTemperatureC      Decimal?  @db.Decimal(5, 2)
  accumulatedGdd        Decimal?  @db.Decimal(8, 2)
  requiredGdd           Decimal?  @db.Decimal(8, 2)
  gddProgressPct        Decimal?  @db.Decimal(5, 2)
  weatherAdjustDays     Int       @default(0)
  weatherAvailable      Boolean   @default(false)
  dataQualityJson       String?   @db.Text
  explanationJson       String?   @db.Text
  assumptionsJson       String?   @db.Text
  inputSnapshotJson     String?   @db.Text
  createdAt             DateTime  @default(now())

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                  Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                  Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)
  harvestOutcomes       HarvestOutcome[]
  evaluations           PredictionEvaluation[]

  @@index([userId, cropId])
  @@index([cropId, predictionDate])
  @@index([farmId])
  @@map("harvest_predictions")
}

// ==========================================
// Phase AI-3: Weather Intelligence & Harvest Risk Engine Models
// ==========================================
model WeatherAssessment {
  id                    String    @id @default(cuid())
  userId                String    @db.VarChar(191)
  farmId                String    @db.VarChar(191)
  cropId                String?   @db.VarChar(191)
  overallRiskScore      Int       @default(0) // 0-100
  harvestSuitability    String    @db.VarChar(30) // "FAVORABLE" | "CAUTION" | "UNFAVORABLE" | "INSUFFICIENT_DATA"
  urgency               String    @db.VarChar(20) // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  confidence            String    @db.VarChar(30) // "HIGH" | "MODERATE" | "LOW" | "INSUFFICIENT_DATA"
  rainfallRiskScore     Int       @default(0)
  humidityRiskScore     Int       @default(0)
  windRiskScore         Int       @default(0)
  temperatureRiskScore  Int       @default(0)
  harvestWindowStart    DateTime?
  harvestWindowEnd      DateTime?
  forecastCoverageStart DateTime?
  forecastCoverageEnd   DateTime?
  risksJson             String?   @db.LongText
  recommendationsJson   String?   @db.Text
  explanationJson       String?   @db.Text
  dataQualityJson       String?   @db.Text
  sourceProvider        String    @db.VarChar(100)
  sourceFetchedAt       DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                  Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                  Crop?     @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([userId, cropId])
  @@index([farmId])
  @@index([cropId, createdAt])
  @@index([createdAt])
  @@map("weather_assessments")
}

// ==========================================
// Phase AI-5: Yield Forecasting and Production Estimation Models
// ==========================================
model YieldPrediction {
  id                             String    @id @default(cuid())
  userId                         String    @db.VarChar(191)
  farmId                         String    @db.VarChar(191)
  cropId                         String    @db.VarChar(191)
  predictedYieldTonnesPerHectare Decimal   @db.Decimal(10, 4)
  plantedAreaHectares            Decimal   @db.Decimal(12, 4)
  originalAreaValue              Decimal   @db.Decimal(12, 4)
  originalAreaUnit               String    @default("HECTARE") @db.VarChar(30)
  expectedProductionTonnes       Decimal   @db.Decimal(14, 4)
  lowerYieldTonnesPerHectare     Decimal?  @db.Decimal(10, 4)
  upperYieldTonnesPerHectare     Decimal?  @db.Decimal(10, 4)
  lowerProductionTonnes          Decimal?  @db.Decimal(14, 4)
  upperProductionTonnes          Decimal?  @db.Decimal(14, 4)
  predictionStage                String    @default("MID_SEASON") @db.VarChar(50)
  confidence                     String    @default("MODERATE") @db.VarChar(30) // "HIGH" | "MODERATE" | "LOW"
  modelVersion                   String    @default("1.0.0") @db.VarChar(60)
  algorithm                      String    @default("HistGradientBoostingRegressor") @db.VarChar(100)
  uncertaintyMethod              String?   @db.VarChar(80)
  inputSnapshotJson              String?   @db.Text
  dataQualityJson                String?   @db.Text
  evaluatedAt                    DateTime  @default(now())
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  user                           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                           Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                           Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([userId, cropId])
  @@index([farmId])
  @@index([cropId, evaluatedAt])
  @@index([evaluatedAt])
  @@map("yield_predictions")
}

model ActualProduction {
  id                          String    @id @default(cuid())
  userId                      String    @db.VarChar(191)
  farmId                      String    @db.VarChar(191)
  cropId                      String    @db.VarChar(191)
  actualYieldTonnesPerHectare Decimal?  @db.Decimal(10, 4)
  actualProductionTonnes      Decimal   @db.Decimal(14, 4)
  originalQuantity            Decimal   @db.Decimal(14, 4)
  originalUnit                String    @default("TONNE") @db.VarChar(30)
  harvestDate                 DateTime  @default(now())
  notes                       String?   @db.Text
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                        Crop      @relation(fields: [cropId], references: [id], onDelete: Cascade)

  @@index([userId, cropId])
  @@index([farmId])
  @@index([cropId, harvestDate])
  @@map("actual_productions")
}

// ==========================================
// Phase AI-6: Crop Disease and Health Detection Models
// ==========================================
model CropHealthAnalysis {
  id                  String    @id @default(cuid())
  userId              String    @db.VarChar(191)
  farmId              String?   @db.VarChar(191)
  cropId              String?   @db.VarChar(191)
  imageUrl            String?   @db.VarChar(500)
  imageName           String?   @db.VarChar(255)
  predictedClassId    String    @db.VarChar(100)
  predictedClassName  String    @db.VarChar(150)
  cropName            String    @db.VarChar(100)
  conditionCategory   String    @db.VarChar(50)
  confidence          Decimal   @db.Decimal(5, 2)
  confidenceLevel     String    @db.VarChar(30)
  status              String    @db.VarChar(30)
  symptomsJson        String?   @db.Text
  recommendationsJson String?   @db.Text
  alternativesJson    String?   @db.Text
  qualityWarningsJson String?   @db.Text
  expertAdvice        String?   @db.Text
  modelVersion        String    @default("1.0.0") @db.VarChar(60)
  analyzedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                Farm?     @relation(fields: [farmId], references: [id], onDelete: SetNull)
  crop                Crop?     @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@index([userId, analyzedAt])
  @@index([cropId])
  @@index([farmId])
  @@map("crop_health_analyses")
}

// ==========================================
// Phase AI-9: Prediction Monitoring and Continuous Improvement Models
// ==========================================
model HarvestOutcome {
  id                  String    @id @default(cuid())
  userId              String    @db.VarChar(191)
  farmId              String    @db.VarChar(191)
  cropId              String    @db.VarChar(191)
  predictionId        String?   @db.VarChar(191)
  actualHarvestDate   DateTime
  actualHarvestStart  DateTime?
  actualHarvestEnd    DateTime?
  season              String?   @db.VarChar(50)
  outcomeSource       String    @default("FARMER_RECORDED") @db.VarChar(50) // "FARMER_RECORDED" | "INSPECTOR_VERIFIED" | "REMOTE_SENSED" | "HISTORICAL_RECORD"
  verificationStatus  String    @default("PENDING_VERIFICATION") @db.VarChar(40) // "PENDING_VERIFICATION" | "VERIFIED" | "REJECTED" | "CORRECTED"
  verifiedAt          DateTime?
  verifiedByUserId    String?   @db.VarChar(191)
  verificationNotes   String?   @db.Text
  consentEvaluation   Boolean   @default(true)
  consentTraining     Boolean   @default(false)
  notes               String?   @db.Text
  correctionCount     Int       @default(0)
  previousOutcomeJson String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm                Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                Crop                @relation(fields: [cropId], references: [id], onDelete: Cascade)
  prediction          HarvestPrediction?  @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  evaluations         PredictionEvaluation[]

  @@index([userId, cropId])
  @@index([farmId])
  @@index([cropId, actualHarvestDate])
  @@index([verificationStatus])
  @@index([predictionId])
  @@map("harvest_outcomes")
}

model PredictionEvaluation {
  id                    String    @id @default(cuid())
  outcomeId             String    @db.VarChar(191)
  predictionId          String    @db.VarChar(191)
  cropId                String    @db.VarChar(191)
  farmId                String    @db.VarChar(191)
  modelVersion          String    @db.VarChar(60)
  modelName             String    @default("HarvestWindow-Predictor") @db.VarChar(100)
  actualHarvestDate     DateTime
  predictedHarvestDate  DateTime
  predictedWindowStart  DateTime?
  predictedWindowEnd    DateTime?
  errorDays             Int       // actual - predicted: positive = late, negative = early
  absoluteErrorDays     Int
  isExactDate           Boolean   @default(false)
  isWithin3Days         Boolean   @default(false)
  isWithin7Days         Boolean   @default(false)
  isWithinWindow        Boolean?
  windowDistanceDays    Int?      // distance to nearest boundary if outside
  forecastHorizonDays   Int?      // days between prediction generation and actual harvest
  evaluationRevision    Int       @default(1)
  isEligibleForTraining Boolean   @default(false)
  exclusionReason       String?   @db.VarChar(150)
  calculatedAt          DateTime  @default(now())

  outcome               HarvestOutcome    @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  prediction            HarvestPrediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@unique([outcomeId, predictionId, evaluationRevision])
  @@index([cropId])
  @@index([farmId])
  @@index([modelVersion])
  @@index([calculatedAt])
  @@map("prediction_evaluations")
}

model ModelEvaluationReport {
  id                    String    @id @default(cuid())
  reportId              String    @unique @db.VarChar(100)
  modelVersion          String    @db.VarChar(60)
  modelName             String    @default("HarvestWindow-Predictor") @db.VarChar(100)
  evaluationPeriodStart DateTime?
  evaluationPeriodEnd   DateTime?
  cropFilter            String?   @db.VarChar(100)
  regionFilter          String?   @db.VarChar(100)
  seasonFilter          String?   @db.VarChar(50)
  totalEvaluated        Int       @default(0)
  eligibleCount         Int       @default(0)
  excludedCount         Int       @default(0)
  meanAbsoluteError     Decimal?  @db.Decimal(8, 3)
  meanSignedError       Decimal?  @db.Decimal(8, 3) // Bias
  rootMeanSquaredError  Decimal?  @db.Decimal(8, 3)
  exactDateAccuracyPct  Decimal?  @db.Decimal(6, 2)
  within3DaysPct        Decimal?  @db.Decimal(6, 2)
  within7DaysPct        Decimal?  @db.Decimal(6, 2)
  windowCoveragePct     Decimal?  @db.Decimal(6, 2)
  meanWindowDistance    Decimal?  @db.Decimal(8, 3)
  isInsufficientData    Boolean   @default(false)
  subgroupsJson         String?   @db.LongText // crop, region, horizon breakdowns
  warningsJson          String?   @db.Text
  generatedBy           String    @default("SCHEDULED_JOB") @db.VarChar(50)
  schemaVersion         String    @default("1.0.0") @db.VarChar(20)
  createdAt             DateTime  @default(now())

  @@index([modelVersion])
  @@index([createdAt])
  @@index([cropFilter])
  @@index([regionFilter])
  @@map("model_evaluation_reports")
}

model DriftAssessment {
  id                   String    @id @default(cuid())
  assessmentId         String    @unique @db.VarChar(100)
  modelVersion         String    @db.VarChar(60)
  driftType            String    @db.VarChar(50) // "INPUT_DATA_DRIFT" | "PERFORMANCE_DRIFT" | "PREDICTION_DRIFT"
  severity             String    @default("NORMAL") @db.VarChar(30) // "NORMAL" | "WATCH" | "WARNING" | "CRITICAL" | "INSUFFICIENT_DATA"
  referencePeriodStart DateTime?
  referencePeriodEnd   DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  referenceSampleSize  Int       @default(0)
  currentSampleSize    Int       @default(0)
  featuresCheckedJson  String?   @db.Text
  statisticalMethod    String    @db.VarChar(100) // "PSI_AND_KS_TEST" | "ROLLING_ERROR_SPIKE"
  driftScore           Decimal?  @db.Decimal(8, 4)
  threshold            Decimal?  @db.Decimal(8, 4)
  summaryDetailsJson   String?   @db.LongText
  recommendations      String?   @db.Text
  createdAt            DateTime  @default(now())

  @@index([modelVersion])
  @@index([driftType])
  @@index([severity])
  @@index([createdAt])
  @@map("drift_assessments")
}

model ModelVersionRegistry {
  id                  String    @id @default(cuid())
  modelName           String    @db.VarChar(100)
  modelVersion        String    @db.VarChar(60)
  trainingRunId       String?   @db.VarChar(100)
  experimentName      String?   @db.VarChar(100)
  datasetReference    String?   @db.VarChar(255)
  datasetFingerprint  String?   @db.VarChar(64)
  featureSchemaVer    String    @default("1.0.0") @db.VarChar(30)
  algorithm           String    @default("AgronomicGDDHybrid") @db.VarChar(100)
  hyperparametersJson String?   @db.Text
  validationMae       Decimal?  @db.Decimal(8, 3)
  validationRmse      Decimal?  @db.Decimal(8, 3)
  validationBias      Decimal?  @db.Decimal(8, 3)
  promotionStatus     String    @default("CANDIDATE") @db.VarChar(40) // "CANDIDATE" | "VALIDATED" | "ACTIVE_PRODUCTION" | "DEPRECATED" | "REJECTED"
  rejectionReason     String?   @db.Text
  isActive            Boolean   @default(false)
  promotedAt          DateTime?
  promotedByUserId    String?   @db.VarChar(191)
  artifactPath        String?   @db.VarChar(255)
  artifactChecksum    String?   @db.VarChar(64)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([modelName, modelVersion])
  @@index([modelName, isActive])
  @@index([promotionStatus])
  @@map("model_version_registry")
}

model MonitoringJobRun {
  id                 String    @id @default(cuid())
  jobType            String    @db.VarChar(60) // "OUTCOME_EVALUATION" | "PERFORMANCE_REPORT" | "DRIFT_MONITORING" | "RETRAINING_ELIGIBILITY" | "CANDIDATE_TRAINING" | "CANDIDATE_VALIDATION"
  status             String    @default("PENDING") @db.VarChar(30) // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED" | "SKIPPED"
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  recordsProcessed   Int       @default(0)
  resultsSummaryJson String?   @db.Text
  errorMessage       String?   @db.Text
  triggeredBy        String    @default("SCHEDULED") @db.VarChar(50) // "SCHEDULED" | "MANUAL_ADMIN" | "EVENT_DRIVEN"
  createdAt          DateTime  @default(now())

  @@index([jobType, status])
  @@index([startedAt])
  @@map("monitoring_job_runs")
}




