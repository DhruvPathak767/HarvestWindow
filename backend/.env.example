# ==============================================================================
# HarvestWindow Backend Environment Configuration
# Copy this file to backend/.env and customize with your local settings.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client Application URL (For CORS allowlisting; Vite default is http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# MySQL Database Connection String (Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/harvestwindow"

# Test Database Connection String (Used for automated test suite isolation)
TEST_DATABASE_URL="mysql://root:password@localhost:3306/harvestwindow_test"

# JWT Authentication Secrets (Must be at least 32 characters each)
# Generate random keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_a_long_random_secret_at_least_32_chars_min_example"
JWT_REFRESH_SECRET="replace_with_an_independent_long_random_secret_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=harvestwindow-auth
JWT_AUDIENCE=harvestwindow-app

# Cookie Security Settings (Set COOKIE_SECURE=true when running over HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Administrative Account Initializer (Created on prisma/seed.js)
ADMIN_NAME="HarvestWindow Administrator"
ADMIN_EMAIL="admin@harvestwindow.local"
ADMIN_PASSWORD="HarvestAdmin#2026!Secure"

# Meteorological Provider Configuration
# Open-Meteo operates out-of-the-box with zero API keys required.
# WeatherAPI key is optional; provides live 3-day local radar observations if supplied.
WEATHERAPI_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# Python AI & Machine Learning Microservice URL (FastAPI service on port 8000)
HARVEST_AI_SERVICE_URL=http://127.0.0.1:8000

# ==============================================================================
# Agricultural AI Assistant LLM Provider Configuration
# ==============================================================================
# HarvestWindow includes a zero-cost local agronomic reasoning engine by default.
# It requires NO external API keys and answers strictly using ICAR & FAO research.
#
# To connect an external LLM provider, specify LLM_PROVIDER and your API key:
# Options: "local" (default) | "gemini" | "openai" | "ollama"
LLM_PROVIDER=local

# Google Gemini (Optional - e.g., gemini-1.5-flash)
GEMINI_API_KEY=

# OpenAI (Optional - e.g., gpt-4o-mini)
OPENAI_API_KEY=

# Local Ollama Server (Optional - e.g., for local Llama-3 or Mistral)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3
