# Server Environment
NODE_ENV=development
PORT=5000

# Client Configuration (Vite default is http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# MySQL Database Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/harvestwindow

# Test Database Connection String (used for test suite isolation)
TEST_DATABASE_URL=mysql://root:password@localhost:3306/harvestwindow_test

# JWT Configuration
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars_min
JWT_REFRESH_SECRET=replace_with_an_independent_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=harvestwindow-auth
JWT_AUDIENCE=harvestwindow-app

# Cookie Security Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Administrative Account Initializer (used by prisma/seed.js)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@harvestwindow.local"
ADMIN_PASSWORD="ChangeMe_AdminPassword123!"

# Weather Provider Configuration (Optional WeatherAPI.com, falls back to Open-Meteo)
WEATHERAPI_KEY=your_weatherapi_key_here
WEATHERAPI_BASE_URL=

# AI Harvest Prediction Engine Service (FastAPI Python Service)
HARVEST_AI_SERVICE_URL=http://127.0.0.1:8000
